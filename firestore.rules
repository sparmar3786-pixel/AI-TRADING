rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function ownsExistingDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }
    function ownsIncomingDocument() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // User-owned records: deny access unless the document is tied to the
    // authenticated Firebase UID. Existing records without userId are denied
    // until migrated; do not restore public access to make them appear.
    match /paper_trades/{document=**} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsIncomingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }
    match /user_signals/{document=**} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsIncomingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }
    match /portfolio/{document=**} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsIncomingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }
    match /settings/{document=**} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsIncomingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }
    match /trading_actions/{document=**} {
      allow read, delete: if ownsExistingDocument();
      allow create: if ownsIncomingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }

    // Market snapshots are shared market data: clients may read after auth,
    // but must never write/poison the shared feed from the client.
    match /market_snapshots/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Explicit deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}